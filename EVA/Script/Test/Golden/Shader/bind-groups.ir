global @camera: *uniform Camera bind_group(0)
global @material: *uniform Material bind_group(2)
global @VS.in0: *input float3 location(0)
global @VS.out0: *output float4 semantic(position)
global @PS.out0: *output float4 location(0)

function @VS(%0: float3): float4
	local $0: *function float3
	local $1: *function float4
block0:
	store $0, %0
	%1: float3 = load $0
	%2: *uniform float = access @camera, uint 6
	%3: float = load %2
	%4: float3 = construct %3, %3, %3
	%5: float3 = mul %1, %4
	%6: float4 = construct %5, float 1.0
	store $1, %6
	%7: *uniform float4x4 = access @camera, uint 0
	%8: float4x4 = load %7
	%9: float4 = load $1
	%10: float4 = matmul %8, %9
	%11: *uniform [2]Light = access @camera, uint 7
	%12: *uniform Light = access %11, uint 1
	%13: *uniform float3 = access %12, uint 2
	%14: float3 = load %13
	%15: *uniform [3]float = access @camera, uint 9
	%16: *uniform float = access %15, uint 2
	%17: float = load %16
	%18: float4 = construct %14, %17
	%19: float4 = add %10, %18
	return %19

function @PS(): float4
block0:
	%0: *uniform float3 = access @material, uint 3
	%1: float3 = load %0
	%2: *uniform float = access @material, uint 0
	%3: float = load %2
	%4: float4 = construct %1, %3
	return %4

function @VS.entry(): void [entry vertex]
block0:
	%0: float3 = load @VS.in0
	%1: float4 = call @VS, %0
	store @VS.out0, %1
	return

function @PS.entry(): void [entry fragment]
block0:
	%0: float4 = call @PS
	store @PS.out0, %0
	return
