// VS (vertex)
#include <metal_stdlib>
using namespace metal;

struct S1
{
	float4 m0;
	uint m1;
};

struct S0
{
	float4 m0;
	float2 m1;
	S1 m2;
};

struct In
{
	int in0 [[attribute(0)]];
	float2 in1 [[attribute(3)]];
};

struct Out
{
	float2 out0 [[user(locn0)]];
	float4 out1 [[user(locn1)]];
	uint out2 [[user(locn2)]];
	float4 out3 [[position]];
};

void f0(uint p0, float2 p1, int p2, thread S0& p3)
{
	uint l0 = {};
	float2 l1 = {};
	int l2 = {};
	l0 = p0;
	l1 = p1;
	l2 = p2;
	float2 v0 = l1;
	float4 v1 = float4(v0, 0.0, 1.0);
	p3.m0 = v1;
	float2 v2 = l1;
	p3.m1 = v2;
	float4 v3 = float4(1.0, 1.0, 1.0, 1.0);
	p3.m2.m0 = v3;
	uint v4 = l0;
	p3.m2.m1 = v4;
}

vertex Out main0(uint in2 [[vertex_id]], In in [[stage_in]])
{
	Out out = {};
	S0 l0 = {};
	uint v0 = in2;
	float2 v1 = in.in1;
	int v2 = in.in0;
	f0(v0, v1, v2, l0);
	float4 v3 = l0.m0;
	out.out3 = v3;
	float2 v4 = l0.m1;
	out.out0 = v4;
	float4 v5 = l0.m2.m0;
	out.out1 = v5;
	uint v6 = l0.m2.m1;
	out.out2 = v6;
	return out;
}

// PS (fragment)
#include <metal_stdlib>
using namespace metal;

struct S1
{
	float4 m0;
	uint m1;
};

struct S0
{
	float4 m0;
	float2 m1;
	S1 m2;
};

struct In
{
	float2 in0 [[user(locn0)]];
	float4 in1 [[user(locn1)]];
	uint in2 [[user(locn2), flat]];
	float4 in3 [[position]];
};

struct Out
{
	float4 out0 [[color(0)]];
};

float4 f0(thread S0& p0)
{
	float4 v0 = p0.m2.m0;
	return v0;
}

fragment Out main0(In in [[stage_in]])
{
	Out out = {};
	S0 l0 = {};
	float4 v0 = in.in3;
	l0.m0 = v0;
	float2 v1 = in.in0;
	l0.m1 = v1;
	float4 v2 = in.in1;
	l0.m2.m0 = v2;
	uint v3 = in.in2;
	l0.m2.m1 = v3;
	float4 v4 = f0(l0);
	out.out0 = v4;
	return out;
}
