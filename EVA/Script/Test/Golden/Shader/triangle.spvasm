; VSMain (vertex)
OpCapability Shader
%38 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %2 "main" %18 %21
OpDecorate %18 BuiltIn VertexIndex
OpDecorate %21 BuiltIn Position
%3 = OpTypeFloat 32
%4 = OpTypeVector %3 2
%5 = OpTypeInt 32 0
%6 = OpConstant %5 3
%7 = OpTypeArray %4 %6
%8 = OpTypePointer Private %7
%10 = OpConstant %3 0
%11 = OpConstant %3 0.5
%12 = OpConstantComposite %4 %10 %11
%13 = OpConstant %3 -0.5
%14 = OpConstantComposite %4 %11 %13
%15 = OpConstantComposite %4 %13 %13
%16 = OpConstantComposite %7 %12 %14 %15
%9 = OpVariable %8 Private %16
%17 = OpTypePointer Input %5
%18 = OpVariable %17 Input
%19 = OpTypeVector %3 4
%20 = OpTypePointer Output %19
%21 = OpVariable %20 Output
%22 = OpTypeVoid
%23 = OpTypeFunction %22
%30 = OpTypeFunction %19 %5
%33 = OpConstantNull %5
%35 = OpTypePointer Function %5
%37 = OpConstant %5 2
%40 = OpTypePointer Private %4
%43 = OpConstant %3 1
%2 = OpFunction %22 None %23
%24 = OpLabel
%25 = OpLoad %5 %18
%26 = OpFunctionCall %19 %1 %25
%27 = OpCompositeExtract %3 %26 1
%28 = OpFNegate %3 %27
%29 = OpCompositeInsert %19 %28 %26 1
OpStore %21 %29
OpReturn
OpFunctionEnd
%1 = OpFunction %19 None %30
%31 = OpFunctionParameter %5
%32 = OpLabel
%34 = OpVariable %35 Function %33
OpStore %34 %31
%36 = OpLoad %5 %34
%39 = OpExtInst %5 %38 UMin %36 %37
%41 = OpAccessChain %40 %9 %39
%42 = OpLoad %4 %41
%44 = OpCompositeConstruct %19 %42 %10 %43
OpReturnValue %44
OpFunctionEnd

; PSMain (fragment)
OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %2 "main" %6
OpExecutionMode %2 OriginUpperLeft
OpDecorate %6 Location 0
%3 = OpTypeFloat 32
%4 = OpTypeVector %3 4
%5 = OpTypePointer Output %4
%6 = OpVariable %5 Output
%7 = OpTypeVoid
%8 = OpTypeFunction %7
%11 = OpTypeFunction %4
%13 = OpConstant %3 1
%2 = OpFunction %7 None %8
%9 = OpLabel
%10 = OpFunctionCall %4 %1
OpStore %6 %10
OpReturn
OpFunctionEnd
%1 = OpFunction %4 None %11
%12 = OpLabel
%14 = OpCompositeConstruct %4 %13 %13 %13 %13
OpReturnValue %14
OpFunctionEnd
