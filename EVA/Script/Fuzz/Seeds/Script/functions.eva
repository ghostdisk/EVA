function f(a: float, b: float2): float2
{
	let x: float2;
	{
		const k = 2.0;
		let y: float;
		return b * float2(k) + x;
	}
}

function g(): void
{
	function nested(v: int): int
	{
		return -v;
	}
	return;
}

@entry(vertex)
function main(@semantic(vertex_index) id: uint): @semantic(position) float4
{
	return float4(f(1.0, float2(2.0)), 0.0, 1.0);
}
