@vertex @fragment
function f(@location(0) a: float4, @location(1 + 1) b: float4, @builtin(position) p: float4): @location(0) float4
{
	return a;
}

struct S
{
	@builtin(position) p: float4;
	@location(3) c: float3;
}

const loc: uint = 5;
function g(@location(loc) x: float): @location(1) float
{
	return x;
}
